# ==============================================================================
# Women's Safety Device Prototype - Configuration
# Copy this file to .env and customize your secrets and credentials.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-flask-sessions

# Dashboard Web Access Authentication
# Used to log in to the responsive web dashboard from computer or mobile browser
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeThisPassword123!

# Hardware Device Upload Authentication
# ESP32 must send this exact token in the HTTP header:
# 'X-Device-Token: <token>' or 'Authorization: Bearer <token>'
DEVICE_UPLOAD_TOKEN=esp32-safety-device-secret-token-xyz987

# Base URL for alert links sent via notifications (optional)
# e.g., http://192.168.1.50:5000 (your computer's local Wi-Fi IP)
BASE_URL=http://localhost:5000

# WhatsApp Cloud API (Optional - Official Meta Business Cloud API)
# Leave these empty if WhatsApp alerts are not configured yet.
# When empty, the app will continue to work normally and log "WhatsApp not configured".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE_NUMBER=

# Cloudinary Cloud Storage (Optional - For persistent cloud hosting on Render/Vercel)
# Sign up free at https://cloudinary.com
# When empty, uploads are stored locally in the uploads/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
